# Test-only Docker helper. Credentials only travel through stdin/stdout/files.
set +x
set -euo pipefail
umask 077
: "${E2E_HELPER_STORE:?}"
case "$1" in
  store)
    jq -e '{ServerURL, Username, Secret}' > "$E2E_HELPER_STORE"
    ;;
  get)
    server="$(</dev/stdin)"
    if [[ -f "$E2E_HELPER_STORE" ]] && jq -e --arg server "$server" '.ServerURL == $server' "$E2E_HELPER_STORE" >/dev/null; then
      jq '{Username, Secret}' "$E2E_HELPER_STORE"
    else
      echo 'credentials not found in native keychain'
      exit 1
    fi
    ;;
  erase)
    rm -f "$E2E_HELPER_STORE"
    ;;
  *) exit 1 ;;
esac
